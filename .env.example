DATABASE_URL=
# AI chat providers (OpenAI-compatible), tried in order; providers without a key are skipped.
# Available: gemini, groq, openrouter, cerebras
AI_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

NEXTAUTH_SECRET=

GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
# AI chat daily message limits (reset at 00:00 UTC)
AI_CHAT_USER_DAILY_LIMIT=20
AI_CHAT_GUEST_DAILY_LIMIT=5
AI_CHAT_GLOBAL_DAILY_LIMIT=300
